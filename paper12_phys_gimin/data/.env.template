# Lightning AI credentials (loaded by scripts/lightning_driver.py + lightning_anchor_driver.py)
#
# HOW TO USE:
# 1. Copy this file to paper12_phys_gimin/data/.env (no .template suffix)
# 2. Get values from https://lightning.ai/me/keys on the correct account
#    (open in a private/incognito window to bypass browser SSO)
# 3. Replace placeholders below
# 4. Save. The drivers will auto-load at startup.
#
# SECURITY: .env is gitignored at paper12_phys_gimin/data/. DO NOT move it
# elsewhere in the repo or your API key will leak to GitHub.

LIGHTNING_USER_ID=PASTE_USERNAME_HERE                        # e.g. bddupre92 (NOT the UUID)
LIGHTNING_API_KEY=PASTE_API_KEY_HERE                         # UUID format, 36 chars
LIGHTNING_USERNAME=PASTE_USERNAME_HERE                       # same as USER_ID, used for Studio owner
LIGHTNING_TEAMSPACE=PASTE_TEAMSPACE_NAME_HERE                # your teamspace name, from lightning.ai/studios
